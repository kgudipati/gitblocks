{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitblocks.dev/schemas/evaluation/repository-interviews/run-summary/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "corpusId": {
      "const": "repository-interviews-v1"
    },
    "corpusVersion": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "calibration",
        "gate-a"
      ]
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 56,
      "pattern": "^evalrun-[0-9a-f]{48}$"
    },
    "modelProfileDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidateResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "executionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 58
          },
          "interviewId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 58
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "completed",
              "provider-failed",
              "schema-failed",
              "citation-failed",
              "persistence-failed",
              "policy-failed"
            ]
          },
          "contractValid": {
            "type": "boolean"
          },
          "citationClosed": {
            "type": "boolean"
          },
          "crossCandidateReferenceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "crossArtifactSetReferenceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "candidateId",
          "requestId",
          "executionId",
          "interviewId",
          "status",
          "contractValid",
          "citationClosed",
          "crossCandidateReferenceCount",
          "crossArtifactSetReferenceCount"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "corpusId",
    "corpusVersion",
    "stage",
    "runId",
    "modelProfileDigest",
    "candidateResults"
  ]
}
