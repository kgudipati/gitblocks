{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitblocks.dev/schemas/evaluation/manifest/1.0.0",
  "title": "GitBlocks evaluation corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "corpusVersion",
    "evidenceCutoff",
    "status",
    "cases",
    "familyCounts",
    "diversity",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "corpusId": { "$ref": "#/$defs/id" },
    "corpusVersion": { "const": "1.0.0" },
    "evidenceCutoff": { "$ref": "#/$defs/date" },
    "status": { "const": "development-proposed" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/caseEntry" }
    },
    "familyCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "audit-logging",
        "background-jobs",
        "rate-limiting",
        "webhooks"
      ],
      "properties": {
        "authorization": { "type": "integer", "minimum": 0, "maximum": 100 },
        "audit-logging": { "type": "integer", "minimum": 0, "maximum": 100 },
        "background-jobs": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rate-limiting": { "type": "integer", "minimum": 0, "maximum": 100 },
        "webhooks": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairedDifferentWinners",
        "responsibleAbstentions",
        "popularHardConstraintRejections",
        "includesPrisma",
        "includesDrizzle",
        "includesServerless",
        "includesLongRunning",
        "includesWorkerCapable",
        "includesWorkerIncapable",
        "includesRedis",
        "includesNoRedis",
        "includesSingleTenant",
        "includesMultiTenant",
        "includesLicenseConstraint",
        "includesRuntimeConstraint",
        "includesResidencyConstraint",
        "includesEvidenceInsufficiency",
        "includesTieOrPartialOrder",
        "popularityDiffersFromFit"
      ],
      "properties": {
        "pairedDifferentWinners": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "responsibleAbstentions": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "popularHardConstraintRejections": {
          "type": "integer",
          "minimum": 3,
          "maximum": 10
        },
        "includesPrisma": { "const": true },
        "includesDrizzle": { "const": true },
        "includesServerless": { "const": true },
        "includesLongRunning": { "const": true },
        "includesWorkerCapable": { "const": true },
        "includesWorkerIncapable": { "const": true },
        "includesRedis": { "const": true },
        "includesNoRedis": { "const": true },
        "includesSingleTenant": { "const": true },
        "includesMultiTenant": { "const": true },
        "includesLicenseConstraint": { "const": true },
        "includesRuntimeConstraint": { "const": true },
        "includesResidencyConstraint": { "const": true },
        "includesEvidenceInsufficiency": { "const": true },
        "includesTieOrPartialOrder": { "const": true },
        "popularityDiffersFromFit": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringSession", "goldStatus", "independentReviewStatus"],
      "properties": {
        "authoringSession": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goldStatus": { "const": "proposed" },
        "independentReviewStatus": { "const": "not-reviewed" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?:cases|evidence|gold)/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "caseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "capabilityFamily",
        "casePath",
        "caseSha256",
        "evidencePath",
        "evidenceSha256",
        "goldPath",
        "goldSha256"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "capabilityFamily": {
          "enum": [
            "authorization",
            "audit-logging",
            "background-jobs",
            "rate-limiting",
            "webhooks"
          ]
        },
        "casePath": { "$ref": "#/$defs/relativePath" },
        "caseSha256": { "$ref": "#/$defs/hash" },
        "evidencePath": { "$ref": "#/$defs/relativePath" },
        "evidenceSha256": { "$ref": "#/$defs/hash" },
        "goldPath": { "$ref": "#/$defs/relativePath" },
        "goldSha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
