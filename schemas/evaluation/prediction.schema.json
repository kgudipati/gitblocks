{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitblocks.dev/schemas/evaluation/prediction/1.0.0",
  "title": "GitBlocks evaluation prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "outcome",
    "candidates",
    "rankGroups",
    "rankRelations",
    "disclosedUnknownIds",
    "run"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "$ref": "#/$defs/id" },
    "outcome": {
      "enum": ["recommend", "no-viable-candidate", "insufficient-evidence"]
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/candidatePrediction" }
    },
    "rankGroups": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/id" }
      }
    },
    "rankRelations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["higherCandidateId", "lowerCandidateId"],
        "properties": {
          "higherCandidateId": { "$ref": "#/$defs/id" },
          "lowerCandidateId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "disclosedUnknownIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "producer", "producedAt"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "producer": { "type": "string", "minLength": 1, "maxLength": 120 },
        "producedAt": {
          "type": "string",
          "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "candidatePrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "disposition", "reasonCodes", "evidenceIds"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/id" },
        "disposition": {
          "enum": ["recommended", "viable", "rejected", "insufficient-evidence"]
        },
        "reasonCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    }
  }
}
