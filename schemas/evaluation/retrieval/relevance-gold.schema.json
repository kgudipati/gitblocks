{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitblocks.dev/schemas/evaluation/retrieval/relevance-gold/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["relevanceGoldVersion", "caseId", "judgments", "provenance"],
  "properties": {
    "relevanceGoldVersion": { "const": "retrieval-relevance-gold/1.0.0" },
    "caseId": {
      "$ref": "https://gitblocks.dev/schemas/evaluation/retrieval/definitions/1.0.0#/$defs/stableId"
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "grade", "reasonCodes", "provenance"],
        "properties": {
          "candidateId": {
            "$ref": "https://gitblocks.dev/schemas/evaluation/retrieval/definitions/1.0.0#/$defs/stableId"
          },
          "grade": { "type": "integer", "minimum": 0, "maximum": 3 },
          "reasonCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "catalog-family-capability-match",
                "explicit-candidate-intent",
                "family-adjacent-narrow-intent"
              ]
            }
          },
          "provenance": {
            "$ref": "https://gitblocks.dev/schemas/evaluation/retrieval/definitions/1.0.0#/$defs/provenance"
          }
        }
      }
    },
    "provenance": {
      "$ref": "https://gitblocks.dev/schemas/evaluation/retrieval/definitions/1.0.0#/$defs/provenance"
    }
  }
}
