{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitblocks.dev/schemas/evaluation/retrieval/definitions/1.0.0",
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "family": {
      "enum": [
        "authorization",
        "audit-logging",
        "background-jobs",
        "rate-limiting",
        "webhooks"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewStatus",
        "reviewer",
        "reviewedAt",
        "reviewReference"
      ],
      "properties": {
        "status": { "const": "proposed" },
        "reviewStatus": { "const": "not-reviewed" },
        "reviewer": { "type": "null" },
        "reviewedAt": { "type": "null" },
        "reviewReference": { "type": "null" }
      }
    },
    "stringSet": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "sourceIds", "possibleConceptIds"],
      "properties": {
        "reasonCode": { "$ref": "#/$defs/stableId" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "possibleConceptIds": { "$ref": "#/$defs/stringSet" }
      }
    },
    "normalizedConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptId", "sourceTermIds", "ruleId"],
      "properties": {
        "conceptId": { "$ref": "#/$defs/stableId" },
        "sourceTermIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "ruleId": { "$ref": "#/$defs/stableId" }
      }
    },
    "normalizedConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceConstraintIds",
        "modality",
        "facet",
        "resolutionBasis",
        "ruleId",
        "conceptId",
        "canonicalTerm"
      ],
      "properties": {
        "sourceConstraintIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "modality": { "enum": ["preferred", "prohibited", "required"] },
        "facet": { "$ref": "#/$defs/stableId" },
        "resolutionBasis": { "$ref": "#/$defs/stableId" },
        "ruleId": { "$ref": "#/$defs/stableId" },
        "conceptId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "canonicalTerm": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "reasonCode", "blocking"],
      "properties": {
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "reasonCode": { "$ref": "#/$defs/stableId" },
        "blocking": { "type": "boolean" }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "sourceIds", "replacementAliasKey"],
      "properties": {
        "reasonCode": { "$ref": "#/$defs/stableId" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "replacementAliasKey": { "$ref": "#/$defs/stableId" }
      }
    },
    "normalizationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "primaryFamily",
        "normalizedConcepts",
        "normalizedConstraints",
        "unresolved",
        "clarifications",
        "notices"
      ],
      "properties": {
        "outcome": {
          "enum": ["normalized", "clarification-required", "unsupported"]
        },
        "primaryFamily": {
          "oneOf": [{ "$ref": "#/$defs/family" }, { "type": "null" }]
        },
        "normalizedConcepts": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/normalizedConcept" }
        },
        "normalizedConstraints": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/normalizedConstraint" }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/unresolved" }
        },
        "clarifications": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/clarification" }
        },
        "notices": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/notice" }
        }
      }
    },
    "hardState": { "enum": ["conflict", "satisfied", "unresolved"] },
    "lane": { "enum": ["eligible", "evidence-needed", "excluded"] },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value", "status"],
      "properties": {
        "numerator": { "type": "number", "minimum": 0 },
        "denominator": { "type": "number", "minimum": 0 },
        "value": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "status": { "enum": ["applicable", "not-applicable"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "denominator": { "const": 0 } },
            "required": ["denominator"]
          },
          "then": {
            "properties": {
              "numerator": { "const": 0 },
              "value": { "type": "null" },
              "status": { "const": "not-applicable" }
            }
          },
          "else": {
            "properties": {
              "value": { "type": "number" },
              "status": { "const": "applicable" }
            }
          }
        }
      ]
    }
  }
}
