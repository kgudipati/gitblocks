{
  "$id": "https://schemas.gitblocks.dev/operations/profile-materialization/coverage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate": { "$ref": "#/$defs/comparison" },
    "broadRetrievalReadiness": { "$ref": "#/$defs/readiness" },
    "catalogDigest": {
      "const": "4819dd94cb1bbe5e27c31ca5ca55976da1442987a792bf438d96681021cb8634"
    },
    "catalogVersion": { "const": "public-v1" },
    "coverageSemanticDigest": { "$ref": "#/$defs/digest" },
    "coverageVersion": { "const": "profile-materialization-coverage/1.0.0" },
    "finalProfileAuthorityDigest": { "$ref": "#/$defs/digest" },
    "finalSourceAuthorityDigest": { "$ref": "#/$defs/digest" },
    "hardFilterReadiness": { "$ref": "#/$defs/readiness" },
    "offlineProfileAuthorityDigest": {
      "const": "9845ff004c83879de423a566ba906f033a83f7338fca9fc38b6324feffd07bdd"
    },
    "offlineProfileCoverageDigest": {
      "const": "cd81889b92797ddd48ee69623e68c7ba1b614c2948a47896c7763c281f5298b1"
    },
    "perFamily": {
      "items": { "$ref": "#/$defs/family" },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "perField": {
      "items": { "$ref": "#/$defs/field" },
      "maxItems": 27,
      "minItems": 27,
      "type": "array"
    },
    "remainingUnknownReasons": {
      "items": { "$ref": "#/$defs/reason" },
      "maxItems": 64,
      "type": "array"
    },
    "taxonomyDigest": {
      "const": "8b2806ec8862390d0368e1c06ed657983916530f1207be9072d9e4787a61d80e"
    },
    "taxonomyVersion": { "const": "1.0.0" }
  },
  "required": [
    "aggregate",
    "broadRetrievalReadiness",
    "catalogDigest",
    "catalogVersion",
    "coverageSemanticDigest",
    "coverageVersion",
    "finalProfileAuthorityDigest",
    "finalSourceAuthorityDigest",
    "hardFilterReadiness",
    "offlineProfileAuthorityDigest",
    "offlineProfileCoverageDigest",
    "perFamily",
    "perField",
    "remainingUnknownReasons",
    "taxonomyDigest",
    "taxonomyVersion"
  ],
  "title": "Profile materialization coverage comparison 1.0.0",
  "type": "object",
  "$defs": {
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "final": { "$ref": "#/$defs/states" },
        "offline": { "$ref": "#/$defs/states" },
        "transitions": { "$ref": "#/$defs/transitions" }
      },
      "required": ["final", "offline", "transitions"],
      "type": "object"
    },
    "digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "family": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "authorization",
            "audit-logging",
            "background-jobs",
            "rate-limiting",
            "webhooks"
          ]
        },
        "final": { "$ref": "#/$defs/states" },
        "offline": { "$ref": "#/$defs/states" },
        "transitions": { "$ref": "#/$defs/transitions" }
      },
      "required": ["family", "final", "offline", "transitions"],
      "type": "object"
    },
    "field": {
      "additionalProperties": false,
      "properties": {
        "extractionRule": { "$ref": "#/$defs/safeCode" },
        "fieldId": { "$ref": "#/$defs/safeCode" },
        "final": { "$ref": "#/$defs/states" },
        "offline": { "$ref": "#/$defs/states" },
        "remainingUnknown": { "minimum": 0, "type": "integer" },
        "transitions": { "$ref": "#/$defs/transitions" }
      },
      "required": [
        "extractionRule",
        "fieldId",
        "final",
        "offline",
        "remainingUnknown",
        "transitions"
      ],
      "type": "object"
    },
    "readiness": {
      "additionalProperties": false,
      "properties": {
        "finalReadyFacets": {
          "items": { "$ref": "#/$defs/safeCode" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "offlineReadyFacets": {
          "items": { "$ref": "#/$defs/safeCode" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "totalFacets": { "minimum": 1, "type": "integer" }
      },
      "required": ["finalReadyFacets", "offlineReadyFacets", "totalFacets"],
      "type": "object"
    },
    "reason": {
      "additionalProperties": false,
      "properties": {
        "count": { "minimum": 1, "type": "integer" },
        "reasonCode": { "$ref": "#/$defs/safeCode" }
      },
      "required": ["count", "reasonCode"],
      "type": "object"
    },
    "safeCode": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "states": {
      "additionalProperties": false,
      "properties": {
        "conflict": { "minimum": 0, "type": "integer" },
        "known": { "minimum": 0, "type": "integer" },
        "notApplicable": { "minimum": 0, "type": "integer" },
        "unknown": { "minimum": 0, "type": "integer" }
      },
      "required": ["conflict", "known", "notApplicable", "unknown"],
      "type": "object"
    },
    "transition": {
      "additionalProperties": false,
      "properties": {
        "count": { "minimum": 1, "type": "integer" },
        "from": { "enum": ["conflict", "known", "not-applicable", "unknown"] },
        "to": { "enum": ["conflict", "known", "not-applicable", "unknown"] }
      },
      "required": ["count", "from", "to"],
      "type": "object"
    },
    "transitions": {
      "items": { "$ref": "#/$defs/transition" },
      "maxItems": 16,
      "type": "array"
    }
  }
}
