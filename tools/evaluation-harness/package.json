{
  "name": "@gitblocks/evaluation-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "gitblocks-contract-conformance": "./dist/src/contract-conformance-cli.js",
    "gitblocks-evaluation": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc --build",
    "contracts:validate": "node dist/src/contract-conformance-cli.js",
    "typecheck": "tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@gitblocks/contracts": "workspace:0.0.0",
    "@gitblocks/domain": "workspace:0.0.0",
    "@gitblocks/persistence": "workspace:0.0.0",
    "@gitblocks/retrieval": "workspace:0.0.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "dependency-cruiser": "18.1.0",
    "vitest": "4.1.10"
  }
}
